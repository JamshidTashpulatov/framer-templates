{
  "$schema": "Linden token source. Read by scripts/exec/10_color_tokens.js, 11_text_presets.js, scripts/render-dsl.mjs and scripts/check-package.mjs. Edit here, nowhere else.",
  "temperature": "cool",
  "color": {
    "Background/Day": { "hex": "#EEF1F4", "job": "Page base" },
    "Surface/White": { "hex": "#FFFFFF", "job": "Photo mats, forms, clickable cards only" },
    "Surface/Mist": { "hex": "#D8DEE5", "job": "Soft bands: contact sheet, pricing, FAQ" },
    "Brand/Ink": { "hex": "#1A222C", "job": "Headings, dark bands, primary button fill" },
    "Brand/Ink Raised": { "hex": "#2A3440", "job": "Ink button hover, footer band" },
    "Accent/Oxide": { "hex": "#4A6670", "job": "Links, active chips, week tabs, focus ring" },
    "Text/Ink": { "hex": "#1A222C", "job": "Body on light" },
    "Text/Muted": { "hex": "#5C6773", "job": "Secondary copy on light" },
    "Text/On Ink": { "hex": "#EEF1F4", "job": "Text on Ink bands" },
    "Text/On Ink Muted": { "hex": "#A8B2BD", "job": "Muted text on Ink bands" },
    "Border/Hairline": { "hex": "#C5CCD4", "job": "Card and field edges" },
    "Fixed/White": { "hex": "#FFFFFF", "job": "Explicit white" }
  },
  "alpha": {
    "Alpha/Ink 10": { "base": "Brand/Ink", "opacity": 0.1, "job": "Hover fill on light chips, inherits the cool tint" },
    "Alpha/Ink 14": { "base": "Brand/Ink", "opacity": 0.14, "job": "Hairline borders on light surfaces" },
    "Alpha/Ink 72": { "base": "Brand/Ink", "opacity": 0.72, "job": "Secondary text on Mist bands (5.4:1; Text/Muted is only 4.3:1 on Mist)" },
    "Alpha/On Ink 16": { "base": "Text/On Ink", "opacity": 0.16, "job": "Hairlines and chip outlines on Ink bands" }
  },
  "legacyColorHints": [
    { "match": "theatre|night|charcoal|graphite|ink(?!.*raised)", "to": "Brand/Ink" },
    { "match": "raised|theatre ?2|elevated", "to": "Brand/Ink Raised" },
    { "match": "suture|coral|sage|accent|primary", "to": "Accent/Oxide" },
    { "match": "linen|paper|cream|zinc.?50|background|base|canvas", "to": "Background/Day" },
    { "match": "mist|zinc.?(100|200)|stone|band|muted bg|subtle", "to": "Surface/Mist" },
    { "match": "white|surface|card", "to": "Surface/White" },
    { "match": "muted|secondary|zinc.?(500|600)|grey|gray", "to": "Text/Muted" },
    { "match": "border|hairline|divider|stroke|line", "to": "Border/Hairline" }
  ],
  "fonts": {
    "display": { "family": "Source Serif 4", "weights": [600], "fallback": "Georgia, serif", "use": "H1 only" },
    "ui": { "family": "Outfit", "weights": [400, 500, 600], "fallback": "system-ui, sans-serif", "use": "Everything else" }
  },
  "breakpoints": { "desktop": 1200, "tablet": 810, "phone": 0 },
  "typeSizes": {
    "h1": { "desktop": [96, 1.0, "-0.02em"], "tablet": [72, 1.02, "-0.02em"], "phone": [48, 1.05, "-0.015em"] },
    "h2": { "desktop": [48, 1.1, "-0.015em"], "tablet": [40, 1.1, "-0.01em"], "phone": [32, 1.15, "-0.01em"] },
    "lead": { "desktop": [20, 1.6, "0em"], "tablet": [20, 1.6, "0em"], "phone": [18, 1.55, "0em"] },
    "body": { "desktop": [17, 1.65, "0em"], "tablet": [17, 1.65, "0em"], "phone": [16, 1.6, "0em"] },
    "label": { "desktop": [13, 1.4, "0.01em"], "tablet": [13, 1.4, "0.01em"], "phone": [13, 1.4, "0.01em"] }
  },
  "textPresets": {
    "Display/H1": { "size": "h1", "font": "display", "weight": 600, "tag": "h1", "color": "Text/Ink", "balance": true },
    "Display/H1 On Ink": { "size": "h1", "font": "display", "weight": 600, "tag": "h1", "color": "Text/On Ink", "balance": true },
    "Heading/H2": { "size": "h2", "font": "ui", "weight": 500, "tag": "h2", "color": "Text/Ink", "balance": true },
    "Heading/H2 On Ink": { "size": "h2", "font": "ui", "weight": 500, "tag": "h2", "color": "Text/On Ink", "balance": true },
    "Heading/Fact": { "size": "h2", "font": "ui", "weight": 500, "tag": "p", "color": "Text/Ink", "balance": false, "numerals": "tabular" },
    "Heading/Wordmark": { "size": "h1", "font": "ui", "weight": 600, "tag": "p", "color": "Text/On Ink", "balance": false },
    "Text/Lead": { "size": "lead", "font": "ui", "weight": 400, "tag": "p", "color": "Text/Ink", "balance": false },
    "Text/Lead On Ink": { "size": "lead", "font": "ui", "weight": 400, "tag": "p", "color": "Text/On Ink", "balance": false },
    "Text/Card Title": { "size": "lead", "font": "ui", "weight": 500, "tag": "h3", "color": "Text/Ink", "balance": true },
    "Text/Body": { "size": "body", "font": "ui", "weight": 400, "tag": "p", "color": "Text/Ink", "balance": false },
    "Text/Body Muted": { "size": "body", "font": "ui", "weight": 400, "tag": "p", "color": "Text/Muted", "balance": false },
    "Text/Body Muted On Mist": { "size": "body", "font": "ui", "weight": 400, "tag": "p", "color": "Alpha/Ink 72", "balance": false },
    "Text/Body On Ink": { "size": "body", "font": "ui", "weight": 400, "tag": "p", "color": "Text/On Ink", "balance": false },
    "Text/Body On Ink Muted": { "size": "body", "font": "ui", "weight": 400, "tag": "p", "color": "Text/On Ink Muted", "balance": false },
    "Text/Label": { "size": "label", "font": "ui", "weight": 500, "tag": "p", "color": "Text/Ink", "balance": false, "numerals": "tabular" },
    "Text/Label Muted": { "size": "label", "font": "ui", "weight": 500, "tag": "p", "color": "Text/Muted", "balance": false, "numerals": "tabular" },
    "Text/Label Muted On Mist": { "size": "label", "font": "ui", "weight": 500, "tag": "p", "color": "Alpha/Ink 72", "balance": false, "numerals": "tabular" },
    "Text/Label On Ink": { "size": "label", "font": "ui", "weight": 500, "tag": "p", "color": "Text/On Ink Muted", "balance": false }
  },
  "linkPresets": {
    "Link/Oxide": { "color": "Accent/Oxide", "hover": "Brand/Ink", "decoration": "underline", "offset": "3px", "thickness": "1px" },
    "Link/On Ink": { "color": "Text/On Ink", "hover": "Text/On Ink Muted", "decoration": "underline", "offset": "3px", "thickness": "1px" }
  },
  "legacyTextHints": [
    { "match": "h1|display|hero|title", "to": "Display/H1" },
    { "match": "h2|heading|section", "to": "Heading/H2" },
    { "match": "lead|intro|large", "to": "Text/Lead" },
    { "match": "body|paragraph|p\\b|text", "to": "Text/Body" },
    { "match": "label|eyebrow|caption|small|mono|tag", "to": "Text/Label" }
  ],
  "radius": { "pill": 999, "card": 16, "inner": 12, "insetPadding": 4 },
  "space": [4, 8, 16, 24, 32, 48, 64, 96, 128],
  "section": {
    "padY": { "desktop": 128, "tablet": 96, "phone": 64 },
    "gutter": { "desktop": 40, "tablet": 32, "phone": 20 },
    "maxWidth": 1200,
    "measureCh": 66
  },
  "border": { "hairline": "1px solid rgba(26, 34, 44, 0.14)", "hairlineOnInk": "1px solid rgba(238, 241, 244, 0.16)", "imageInset": "inset 0 0 0 1px rgba(26, 34, 44, 0.08)" },
  "shadow": {
    "raised": "0 1px 2px rgba(26, 34, 44, 0.06), 0 8px 24px rgba(26, 34, 44, 0.06)",
    "use": "Mobile menu sheet and phone consult strip only. Cards and mats use hairlines."
  },
  "motion": {
    "spring": { "type": "spring", "visualDuration": 0.35, "bounce": 0.1 },
    "springRange": { "visualDuration": [0.2, 0.6], "bounce": [0, 0.3] },
    "hover": { "duration": 0.15, "ease": [0.25, 0.1, 0.25, 1] },
    "stagger": 0.04,
    "reducedMotion": "No fades or movement. State changes jump."
  },
  "icons": { "family": "Phosphor", "weight": "light", "size": 20, "allowed": ["List", "X", "Plus", "Minus"] }
}
