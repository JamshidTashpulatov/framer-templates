{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": false,
    "types": ["vitest/globals"],
    "paths": { "framer": ["./tests/stubs/framer.ts"] }
  },
  "include": ["code/**/*.tsx", "tests/**/*.tsx", "tests/**/*.ts"]
}
